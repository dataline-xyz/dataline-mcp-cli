# oauth | api_key | x402
DATALINE_AUTH_MODE=oauth

# Public production API by default. Override this for local or test deployments.
DATALINE_DATA_API_URL=https://data-api.dataline.xyz

# Upstream request timeout in milliseconds (100 to 300000).
DATALINE_REQUEST_TIMEOUT_MS=30000

# Development credential injection. OAuth profiles will replace the access-token
# variable for normal user flows. Never commit real credentials.
# DATALINE_ACCESS_TOKEN=
# DATALINE_API_KEY=

# x402 pays real USDC on Base mainnet. Keep the private key out of checked-in files.
# DATALINE_X402_PRIVATE_KEY=0x...
# DATALINE_X402_NETWORK=eip155:8453
# DATALINE_X402_MAX_PAYMENT_USD=0.001
